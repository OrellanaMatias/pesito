# Puerto donde se ejecutará el servidor
PORT=3000

# Host - usar 0.0.0.0 para permitir conexiones desde cualquier dispositivo
HOST=0.0.0.0

# Entorno de ejecución (development, production, test)
NODE_ENV=production

# Configuración de la base de datos MySQL
# En desarrollo local
# DB_HOST=localhost
# En producción (o dentro de Docker usando el nombre del servicio)
DB_HOST=mysql
DB_PORT=3306
DB_USER=pesito
# En producción usar una contraseña segura
DB_PASSWORD=pesito
DB_NAME=pesito

# API Key para Google Gemini (opcional)
# GEMINI_API_KEY=tu_api_key_aqui

# Configuración de seguridad (opcional)
# JWT_SECRET=un_secreto_muy_seguro_y_largo

CORS_ORIGIN=http://localhost:5173
