# Variables de entorno para el servidor
PORT=3000

# Configuración de la base de datos (si fuera necesario)
# DB_PATH=./db/pesito.db

# API Key para Google Gemini (opcional)
# GEMINI_API_KEY=tu_api_key_aqui 

# Variables globales del proyecto Pesito

# IP o dominio del host donde se ejecuta el proyecto
# Ejemplos: localhost, 192.168.1.100, pesito.orellanamatias.com.ar
HOST_IP=localhost

# Puertos para los servicios
FRONTEND_PORT=5173
BACKEND_PORT=3000
MYSQL_PORT=3306

# Configuración de MySQL
MYSQL_DATABASE=pesito
MYSQL_USER=pesito
MYSQL_PASSWORD=pesito
MYSQL_ROOT_PASSWORD=password

# Entorno de ejecución
NODE_ENV=production

# Variable para habilitar el modo desarrollo (true/false)
DEVELOPMENT_MODE=false 
