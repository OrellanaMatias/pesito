# URL de la API del backend
# En desarrollo local se puede usar localhost
# VITE_API_URL=http://localhost:3000/api
# En producción usar la IP o dominio del servidor
# VITE_API_URL=http://ejemplo.com:3000/api

# Puerto de la API (se usará para construir la URL dinámicamente)
VITE_API_URL=http://localhost:3000/api
VITE_API_PORT=3000
NODE_ENV=production
